# Copy to .env — docker compose and `make dev` read it. Everything is optional: the defaults give a working demo.

# --- AI case summaries -------------------------------------------------------
# Without a key the "AI" summaries are produced by the deterministic rules engine.
# Add a key to have Claude write the narratives (the rules still make the decisions).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
LLM_ENABLED=true

# --- Demo data & access ------------------------------------------------------
SEED_ON_STARTUP=true
SEED_SIZE=full            # full = 100 customers / 50 businesses / 500 txns ; small = 11 + 5
DEMO_PASSWORD=demo1234    # shared by all five demo personas — CHANGE if the URL is public
AUTH_SECRET=change-me-in-production
DEMO_OPEN_ACCESS=true     # false = every API call must carry a login token
